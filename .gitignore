# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.env

# Dağıtım / Build
build/
dist/
*.egg-info/
.eggs/
*.spec
*.spec.bak
packaging/__pycache__/

# Uygulama Konfigürasyonu ve Çalışma Verileri
config/config.yaml
config/*.local.yaml
temp/**
